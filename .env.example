RUN_MAINNET_FORK_TESTS=false
MAINNET_RPC_URL=
ETH_RPC_URL=
MAINNET_FORK_BLOCK=24654367
ETHERSCAN_API_KEY=
DATABASE_URL=
RESEARCH_LLM_ENABLED=false
# OpenAI 官方变量，推荐优先使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
# 如果需要兼容其他 OpenAI 风格服务，可显式指定通用变量
# 某些中转站只兼容 /chat/completions，此时把 LLM_API_MODE 改成 chat_completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODE=responses
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2200
SAVE_VERBOSE_ARTIFACTS=false
