{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task Result",
  "type": "object",
  "required": [
    "task_type",
    "target",
    "status",
    "steps",
    "payload"
  ],
  "properties": {
    "task_type": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "detail"
        ]
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
